{
  "manifest_version": 3,
  "name": "Satirical Ad Replacer",
  "version": "1.1.0",
  "description": "Detects advertisement containers and replaces them with satirical predatory UI elements.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Satirical Ad Replacer — Custom Assets"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/imgs/*",
        "assets/fx/*",
        "assets/vids/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
